DynSequence trait = {
	ItemType type

	append fn(self, item ItemType) ItemType
	insert fn(self, after ItemType, item ItemType) ItemType
}

Iterator trait = {
	ItemType type

	has_next fn(self) bool
	next fn(self) ItemType?
}

Sequence trait = {
	IteratorType type

	iter fn(self) Iterator[IteratorType]
}
