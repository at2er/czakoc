Expr type = struct {
	op TOKEN
	values #darr[Value]
}

Stmt type = enum #tag {
	ident_def struct {
		id IDENT
		val Expr
	}
	if_stmt struct {
		cond Expr
		then #darr[Stmt]
	}
	return_stmt Expr
}

TopStmt type = enum #tag {
	fn_dec IDENT
	fn_def struct {
		dec IDENT
		body #darr[Stmt]
	}
}

Value type = enum #tag {
	expr Expr
	int_ i64
	uint u64
}
